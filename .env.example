# ---- Required in production -------------------------------------------------
# Random strings. Generate with: openssl rand -base64 32
APP_SECRET=
CRON_SECRET=
ADMIN_PASSWORD=

# Upstash Redis. Added automatically when you connect the Upstash integration
# in the Vercel dashboard (Storage tab). Either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Optional ---------------------------------------------------------------
# Public URL. Defaults to the Vercel production domain.
# APP_URL=https://your-app.vercel.app

# Pin a SimplifyJobs repo instead of auto-detecting the newest SummerYYYY one.
# SIMPLIFY_REPO=SimplifyJobs/Summer2027-Internships
# SIMPLIFY_BRANCH=dev

# Channel credentials. You can also enter these in the admin dashboard
# (/admin), where they're stored encrypted. Env vars take precedence.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM="Internship Radar <you@gmail.com>"
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=internship_alert
# WHATSAPP_TEMPLATE_LANG=en_US
